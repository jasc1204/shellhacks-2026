{
  "name": "gridlock-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-maplibre": "node -e \"const fs=require('fs');fs.mkdirSync('public/maplibre',{recursive:true});for(const f of ['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])fs.copyFileSync('node_modules/maplibre-gl/dist/'+f,'public/maplibre/'+f)\"",
    "predev": "npm run sync-maplibre",
    "dev": "vite",
    "prebuild": "npm run sync-maplibre",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2"
  }
}
